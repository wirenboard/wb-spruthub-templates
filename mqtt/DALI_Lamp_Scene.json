{
  "manufacturer": "Wiren Board",
  "model": "DALI Gear",
  "modelIds": ["/devices/([a-zA-Z0-9_-]+)/controls/actual_level/meta"],
  "name": "DALI лампа",
  "services": [
    {
      "type": "Lightbulb",
      "characteristics": [
        {
          "type": "Brightness",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/actual_level",
              "topicSet": "/devices/(1)/controls/wanted_level/on",
              "maxValue": 100
            }
          ]
        }
      ]
    },
    {
      "name": "Сцена",
      "type": "C_Option",
      "characteristics": [
        {
          "type": "C_Integer",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/go_to_scene",
              "topicSet": "/devices/(1)/controls/go_to_scene/on",
              "minValue": 0,
              "maxValue": 15
            }
          ]
        }
      ]
    },
    {
      "name": "Ошибка балласта",
      "visible": false,
      "type": "ContactSensor",
      "characteristics": [
        {
          "type": "ContactSensorState",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/error_status"
            }
          ]
        }
      ]
    }
  ]
}
